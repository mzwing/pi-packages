{
  "name": "@mzwing/pi-task-governor",
  "version": "0.1.0",
  "description": "Runs Pi work as a governed task tree: independent executor sessions, jj workspaces and evidence-backed sign-off",
  "keywords": [
    "jj",
    "jujutsu",
    "multi-agent",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "task-management"
  ],
  "homepage": "https://github.com/mzwing/pi-packages/tree/master/packages/pi-task-governor#readme",
  "bugs": {
    "url": "https://github.com/mzwing/pi-packages/issues"
  },
  "license": "MIT",
  "author": {
    "name": "mzwing",
    "email": "mzwing@mzwing.eu.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzwing/pi-packages.git",
    "directory": "packages/pi-task-governor"
  },
  "files": [
    "dist",
    "schemas",
    "config/config.example.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "node --experimental-strip-types scripts/generate-schema.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@mzwing/pi-session-hub": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "catalog:pi-peer",
    "@earendil-works/pi-coding-agent": "catalog:pi-peer",
    "@mzwing/pi-session-hub": "workspace:^",
    "typebox": "catalog:pi-peer"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
