{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mzwing/pi-packages/main/packages/pi-permission-auto-review/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "default": "openai-codex"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "default": "codex-auto-review"
    },
    "reasoning": {
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
      "type": "string",
      "default": "low"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000,
      "default": 90000
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "default": 2
    },
    "attemptTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "followUpReviews": {
      "enum": ["auto", "always", "off"],
      "type": "string",
      "default": "auto"
    },
    "includeBaselinePolicy": {
      "type": "boolean",
      "default": true
    },
    "additionalPolicy": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "includeBaselinePolicy": {
            "const": false
          }
        },
        "required": ["includeBaselinePolicy"]
      },
      "then": {
        "required": ["additionalPolicy"]
      }
    }
  ]
}
