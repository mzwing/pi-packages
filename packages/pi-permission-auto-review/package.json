{
  "name": "@mzwing/pi-permission-auto-review",
  "version": "1.0.0",
  "description": "Codex- and Claude Code-style automatic approval reviews for @gotgenes/pi-permission-system",
  "keywords": [
    "authorizer",
    "auto-mode",
    "auto-review",
    "claude-code",
    "codex",
    "permissions",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/mzwing/pi-packages/tree/main/packages/pi-permission-auto-review#readme",
  "bugs": {
    "url": "https://github.com/mzwing/pi-packages/issues"
  },
  "license": "MIT",
  "author": {
    "name": "mzwing",
    "email": "mzwing@mzwing.eu.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzwing/pi-packages.git",
    "directory": "packages/pi-permission-auto-review"
  },
  "files": [
    "dist",
    "schemas",
    "config/config.example.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "import": "./dist/review.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "node --experimental-strip-types scripts/generate-schema.ts",
    "sync:guardian-policy": "node --experimental-strip-types scripts/sync-guardian-policy.ts",
    "sync:claude-code-policy": "node --experimental-strip-types scripts/sync-claude-code-policy.ts",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@gotgenes/pi-permission-system": "42.0.0",
    "@types/node": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "catalog:pi-peer",
    "@earendil-works/pi-coding-agent": "catalog:pi-peer",
    "@gotgenes/pi-permission-system": "^37.0.0 || ^38.0.0 || ^39.0.0 || ^40.0.0 || ^41.0.0 || ^42.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
