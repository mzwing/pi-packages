{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mzwing/pi-packages/master/packages/pi-task-governor/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "maxExecutors": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 3
    },
    "defaultBookmark": {
      "type": "string",
      "minLength": 1,
      "default": "main"
    },
    "roles": {
      "type": "object",
      "properties": {
        "coordinator": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991,
              "default": 100
            }
          },
          "required": [],
          "additionalProperties": false,
          "default": {}
        },
        "executor": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991,
              "default": 100
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinking": {
              "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false,
          "default": {}
        },
        "developer": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991,
              "default": 100
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinking": {
              "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false,
          "default": {}
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991,
              "default": 40
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinking": {
              "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {}
    },
    "env": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": ["auto", "direnv", "flake", "none"],
          "type": "string",
          "default": "auto"
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {}
    },
    "globalChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["statement", "check"],
        "additionalProperties": false
      },
      "default": []
    }
  },
  "required": [],
  "additionalProperties": false
}
